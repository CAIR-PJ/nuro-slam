Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: emba_world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Image
      Name: Reconstructed panorama
      Enabled: true
      Topic:
        Value: /emba/panorama
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Pose
      Name: Final optimized orientation
      Enabled: true
      Shape: Axes
      Topic:
        Value: /emba/orientation
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
Window Geometry:
  Width: 1100
  Height: 800
