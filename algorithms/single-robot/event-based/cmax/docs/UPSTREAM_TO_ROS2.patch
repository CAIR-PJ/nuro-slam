+namespace cmax_slam {
+void PoseGraphOptimizer::publishTrajectory() {
+  // Export the outgoing, now finalized stride. Do not publish a fabricated position.
+  for(auto t=t_win_beg_; t<t_win_beg_+win_stride_; t+=cmax_port::Duration(0.01)) {
+    const auto q=traj_->evaluate(t).unit_quaternion();
+    geometry_msgs::msg::PoseStamped pose;
+    pose.header.frame_id="cmax_world"; pose.header.stamp=cmax_port::stamp(t);
+    pose.pose.orientation.x=q.x(); pose.pose.orientation.y=q.y();
+    pose.pose.orientation.z=q.z(); pose.pose.orientation.w=q.w();
+    pose_pub_->publish(pose);
+    path_.header=pose.header; path_.poses.push_back(pose);
+    geometry_msgs::msg::TransformStamped tf;
+    tf.header=pose.header; tf.child_frame_id="cmax_camera_optical";
+    tf.transform.rotation=pose.pose.orientation;
+    tf_pub_->sendTransform(tf);
+    if(trajectory_file_) trajectory_file_ << t.ns/1000000000LL << "." << std::setw(9) << std::setfill('0') << t.ns%1000000000LL
+      << std::setfill(' ') << std::setprecision(17) << " 0 0 0 " << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << "\n";
+  }
+  if(path_.poses.size()>10000) path_.poses.erase(path_.poses.begin(),path_.poses.end()-10000);
+  path_pub_->publish(path_);
+  trajectory_file_.flush();
+}
+}
